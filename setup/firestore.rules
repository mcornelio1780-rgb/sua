rules_version = '2';
// sua · Reglas de seguridad de Firestore
// Dónde pegarlas: Firebase Console → tu proyecto → Firestore Database → pestaña "Reglas" (Rules)
// → borra todo → pega este archivo → botón "Publicar" (Publish).
// Qué hacen: cualquiera puede CREAR un lead desde la web, pero NADIE puede leer,
// editar ni borrar desde internet. Tú ves los leads en la consola de Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name','email','company','country','spend','message','lang','source','created_at'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && (!('message' in request.resource.data) || request.resource.data.message.size() < 2000);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
